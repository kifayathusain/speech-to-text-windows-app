{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTS conversation document version 1",
  "description": "Extensions are preserved with warnings. Runtime validation additionally checks unique IDs, references, duplicate keys, finite numbers, cumulative silence, UTF-8 byte size and container depth.",
  "type": "object",
  "required": ["speakers", "segments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "speakers": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {"$ref": "#/$defs/speaker"}
    },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "nonblank": {"type": "string", "pattern": "\\S"},
    "speech": {
      "type": "object",
      "properties": {"speed": {"type": "number", "minimum": 0.5, "maximum": 2.0}},
      "additionalProperties": true
    },
    "speaker": {
      "type": "object", "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/nonblank"},
        "voice_direction": {"type": "string"},
        "voice_defaults": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/id"}
        },
        "speech": {"$ref": "#/$defs/speech"}
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object", "required": ["speaker", "text"],
      "properties": {
        "speaker": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/nonblank"},
        "pause_after_seconds": {"type": "number", "minimum": 0, "maximum": 600},
        "voice_direction": {"type": "string"},
        "speech": {"$ref": "#/$defs/speech"}
      },
      "additionalProperties": true
    }
  }
}
